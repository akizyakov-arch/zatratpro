# Copy to .env on the deployment server. Never commit the completed file.
WEB_DOMAIN=panel.your-domain.ru
WEB_BOT_USERNAME=prozatrat_bot
BOT_OWNER_TELEGRAM_ID=0
# Optional manager Mini App at https://WEB_DOMAIN/mini.
# Numeric bot ID from getMe, not the owner's Telegram ID or bot username.
WEB_MINI_APP_ENABLED=false
WEB_TELEGRAM_BOT_ID=0

TELEGRAM_BOT_TOKEN=replace_with_bot_token
OCR_SPACE_API_KEY=replace_with_ocr_key
DEEPSEEK_API_KEY=replace_with_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LOG_LEVEL=INFO

POSTGRES_DB=zatratpro
POSTGRES_USER=zatratpro
POSTGRES_PASSWORD=replace_with_database_password
POSTGRES_HOST=zatratpro-db
POSTGRES_PORT=5432

# HTTPS origin, secure cookies and the trusted proxy are set by the HTTPS overlay.
# Change all three values if this subnet overlaps an existing server network.
FIINOPS_PROXY_SUBNET=172.29.248.0/24
FIINOPS_PROXY_IP=172.29.248.2
FIINOPS_WEB_IP=172.29.248.3

# Direct image recognition model; text extraction uses DEEPSEEK_MODEL.
DEEPSEEK_VISION_MODEL=deepseek-flash

# Optional voice questions via AssemblyAI (cloud secret ASSAMBLY is also accepted).
ASSEMBLYAI_API_KEY=

# Optional Telegram Bot API proxy: http://host:port or socks5://user:password@host:port
# MTProxy (tg://proxy) is not supported. Empty means direct connection.
TELEGRAM_PROXY_URL=
