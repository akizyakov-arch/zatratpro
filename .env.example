TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# OCR.space outbound proxy, independent of Telegram. Empty uses normal HTTPX environment.
OCR_SPACE_PROXY_URL=
OCR_SPACE_API_KEY=your_ocr_space_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LOG_LEVEL=INFO
POSTGRES_DB=zatratpro
POSTGRES_USER=zatratpro
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=zatratpro-db
POSTGRES_PORT=5432
BOT_OWNER_TELEGRAM_ID=0

# Optional MAX adapter. The token belongs to MAX, not Telegram.
MAX_BOT_TOKEN=
# Optional trusted CA certificates (PEM); added to system trust, never verify=false.
MAX_CA_BUNDLE=

# Web control panel. Use the actual HTTPS origin behind a reverse proxy.
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_ORIGIN=https://fiinops.example.com
WEB_ALLOWED_HOSTS=fiinops.example.com
WEB_COOKIE_SECURE=true
WEB_BOT_USERNAME=prozatrat_bot
# Optional MAX public username; if empty, resolved via MAX GET /me.
WEB_MAX_BOT_USERNAME=
WEB_TRUSTED_PROXIES=127.0.0.1
# Telegram Mini App: enable after configuring a public HTTPS origin.
# Numeric bot ID from getMe, not the owner's Telegram ID or bot username.
WEB_MINI_APP_ENABLED=false
WEB_TELEGRAM_BOT_ID=0

# Direct image recognition model; text extraction uses DEEPSEEK_MODEL.
DEEPSEEK_VISION_MODEL=deepseek-flash

# Optional voice questions via AssemblyAI (cloud secret ASSAMBLY is also accepted).
ASSEMBLYAI_API_KEY=

# Optional Telegram Bot API proxy: http://host:port or socks5://user:password@host:port
# MTProxy (tg://proxy) is not supported. Empty means direct connection.
TELEGRAM_PROXY_URL=

# Optional username (without @) for Telegram linking links shown in MAX.
TELEGRAM_BOT_USERNAME=

# Per process: limit simultaneous document downloads/OCR to bound RAM and API work.
DOCUMENT_PROCESSING_CONCURRENCY=4
